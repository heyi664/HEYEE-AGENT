AGENT_HOST=0.0.0.0
AGENT_PORT=8000
AGENT_RELOAD=true
AGENT_MOCK_MODE=true
# In production, the gateway must set X-User-Id and request-body userId is rejected on mismatch.
AGENT_REQUIRE_AUTHENTICATED_USER=false
STREAM_CALLBACK_QUEUE_MAX_EVENTS=256
# Comma-separated browser origins. Do not use '*' together with credentials in production.
AGENT_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
LOG_DIR=./logs
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=7

# AI_API_KEY should be set as a system/user environment variable.
# Do not write real API keys into this example file.
AI_PROVIDER=openai
AI_API_KEY=${AI_API_KEY}
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.7-flash
AI_TIMEOUT_SECONDS=25
# Maximum wait for a model's first visible stream chunk. A pre-token timeout/error
# retries the next candidate; after a visible chunk the current model is kept.
AI_STREAM_FIRST_TOKEN_TIMEOUT_SECONDS=15
AGENT_MAX_STEPS=5

# Embedding API, SiliconFlow is OpenAI-compatible.
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60

# Retrieval post-processing. Keyword and global vector channels are opt-in.
RAG_RETRIEVAL_CANDIDATE_TOP_K=10
RAG_RETRIEVAL_FINAL_TOP_K=5
RAG_RETRIEVAL_KEYWORD_ENABLED=false
RAG_RETRIEVAL_GLOBAL_VECTOR_ENABLED=false
RAG_RETRIEVAL_RERANK_ENABLED=true
TIKA_SERVER_URL=http://127.0.0.1:9998
TIKA_TIMEOUT_SECONDS=60

# Local Ollama example:
# AGENT_MOCK_MODE=false
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434
# AI_MODEL=deepseek-r1:7b

JAVA_SERVICE_URL=http://127.0.0.1:8081
# MCP Server belongs to the business project. Keep disabled/unconfigured until
# that project exposes an authenticated Streamable HTTP MCP endpoint.
MCP_ENABLED=false
MCP_SERVER_URL=
MCP_SERVER_TOKEN=
MCP_TIMEOUT_SECONDS=10
MCP_TOOL_PREFIX=
MCP_FAIL_FAST=false
MCP_CONTEXT_MAX_CHARS=6000
# Knowledge document upload
DATABASE_URL=postgresql+psycopg://user:password@192.168.23.129:5432/ragent
MEMORY_ENABLED=true
MEMORY_HISTORY_KEEP_TURNS=8
MEMORY_SUMMARY_ENABLED=false
MEMORY_SUMMARY_BATCH_SIZE=3
MEMORY_SUMMARY_MAX_CHARS=300
MEMORY_ASYNC_COMPRESS=true
MEMORY_CONTEXT_MAX_CHARS=6000
MEMORY_REDIS_URL=redis://:123456@192.168.23.129:6379/0
MEMORY_LOCK_TTL_SECONDS=120
# Optional cross-instance cancellation. Leave empty for local single-instance mode.
# STREAM_CANCEL_REDIS_URL=redis://:123456@192.168.23.129:6379/0
STREAM_CANCEL_KEY_PREFIX=heyee:stream:cancel
STREAM_CANCEL_CHANNEL=heyee:stream:cancel
STREAM_CANCEL_TTL_SECONDS=1800
STREAM_CANCEL_MAX_TASKS=10000

# Stream admission: FIFO wait queue + expiring concurrency permits. Configure the same
# Redis address on every Agent instance for cluster-wide control; empty means local-only.
STREAM_QUEUE_ENABLED=true
# STREAM_QUEUE_REDIS_URL=redis://:123456@192.168.23.129:6379/0
STREAM_QUEUE_KEY_PREFIX=heyee:stream:queue
STREAM_QUEUE_MAX_CONCURRENT=3
STREAM_QUEUE_MAX_WAIT_SECONDS=20
# Crash-recovery lease; keep it greater than MAX_WAIT_SECONDS * 3.
STREAM_QUEUE_LEASE_SECONDS=600
STREAM_QUEUE_POLL_INTERVAL_MS=200
RUSTFS_ENDPOINT=http://192.168.23.129:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=knowledge-base
RUSTFS_REGION=us-east-1
RUSTFS_PUBLIC_BASE_URL=
UPLOAD_TEMP_DIR=./tmp/uploads
UPLOAD_MAX_SIZE_MB=100
REMOTE_DOWNLOAD_TIMEOUT_SECONDS=60
UPLOAD_CREATED_BY=agent
UPLOAD_RATE_LIMIT_ENABLED=true
UPLOAD_RATE_LIMIT_REDIS_URL=redis://:123456@192.168.23.129:6379/0
UPLOAD_RATE_LIMIT_KEY=heyee:knowledge-upload:semaphore
UPLOAD_RATE_LIMIT_PERMITS=3
UPLOAD_RATE_LIMIT_LEASE_SECONDS=900
UPLOAD_RATE_LIMIT_ACQUIRE_TIMEOUT_MS=0


# RocketMQ chunk dispatch
ROCKETMQ_MOCK_MODE=true
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
ROCKETMQ_PRODUCER_GROUP=heyee-agent-chunk-producer
ROCKETMQ_CONSUMER_GROUP=heyee-agent-chunk-consumer
ROCKETMQ_CHUNK_TOPIC=heyee-knowledge-document-chunk
ROCKETMQ_CHUNK_TAG=START_CHUNK
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=

RAG_QUERY_REWRITE_ENABLED=false
RAG_QUERY_REWRITE_HISTORY_TURNS=2
RAG_QUERY_REWRITE_MAX_SUB_QUESTIONS=5
RAG_QUERY_REWRITE_HISTORY_MAX_CHARS=1500
RAG_QUERY_REWRITE_HISTORY_MESSAGE_MAX_CHARS=500
RAG_TERM_MAPPING_CACHE_TTL_SECONDS=300
RAG_INTENT_ENABLED=true
RAG_INTENT_MIN_SCORE=0.35
RAG_MAX_INTENT_COUNT=3
RAG_INTENT_CACHE_ENABLED=true
RAG_INTENT_CACHE_TTL_SECONDS=604800
RAG_INTENT_LLM_TEMPERATURE=0.1
RAG_INTENT_LLM_TOP_P=0.3
RAG_GUIDANCE_ENABLED=true
RAG_GUIDANCE_SCORE_RATIO=0.8
RAG_GUIDANCE_MARGIN=0.15
RAG_GUIDANCE_MAX_OPTIONS=6
